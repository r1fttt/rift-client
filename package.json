{
  "name": "r1ft-client",
  "version": "0.68.1",
  "description": "Minecraft Java launcher with Microsoft and offline accounts and Modrinth",
  "author": "R1FT",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run build && node scripts/start.cjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env R1FT_DEV=1 node scripts/start.cjs\"",
    "build": "vite build",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "npm run build && node tests/ui.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:live": "node tests/live.cjs",
    "test:pack": "node tests/pack-live.cjs",
    "test:news": "npm run build && node tests/news-ui.cjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "cheerio": "^1.2.0",
    "lucide": "^0.577.0",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "sanitize-html": "^2.17.7",
    "skinview3d": "^3.4.2",
    "tar": "^7.5.10"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.58.2",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.r1ft.client",
    "productName": "R1FT Client",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    },
    "icon": "build/icon.png"
  },
  "overrides": {
    "minecraft-launcher-core": {
      "adm-zip": "$adm-zip"
    },
    "request": "npm:@cypress/request@^4.0.1",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "desktopName": "r1ft-client.desktop"
}
